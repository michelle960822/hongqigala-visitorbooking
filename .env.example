# 复制本文件为 .env 并填入真实值（.env 不会被上传到 GitHub）

# 管理员后台密码（导出/核销/清理用），部署后请务必修改
ADMIN_PASSWORD=404112

# 个人信息加密密钥（首次启动会自动生成并写入 .env，请勿泄露）
# ENCRYPTION_KEY=自动生成

# 身份证校验盐值（防止同名同姓被误判为同一人，建议改成随机串）
PEPPER=change_me_pepper

# 是否强制主预约人填身份证并校验（0=只填姓名，1=强制实名）
REQUIRE_ID=0

# 每个时段名额上限
CAPACITY=30

# 信息留存天数，超过则可在后台一键清理
RETENTION_DAYS=30

# 服务端口（部署平台可能会用环境变量 PORT 覆盖）
PORT=5000
