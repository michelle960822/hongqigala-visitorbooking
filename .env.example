# 配置项示例（部署到 Cloudflare 时填进 wrangler.toml 的 [vars] 或 secret；
# 部署到腾讯云 CloudBase 时设为环境变量。.env 本身不会被上传。）

# 管理员后台密码（导出 / 核销 / 清理用），部署后请务必修改
ADMIN_PASSWORD=888888

# 个人信息加密密钥（base64 编码的随机串，≥16 字节；Cloudflare 用 secret，不要写进代码）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=在此填入生成的密钥

# 身份证校验盐值（防止同名同姓被误判为同一人）
PEPPER=change_me_pepper

# 是否强制主预约人填身份证并校验（0=只填姓名，1=强制实名）
REQUIRE_ID=0

# 每个时段名额上限（仅用于首次写入种子时段，后续改名额请直接改数据库）
CAPACITY=30

# 信息留存天数。依据《个人信息保护法》"必要期限"原则，活动结束后 10 天自动销毁
RETENTION_DAYS=10

# 可选：公网地址，用于生成二维码中的核销链接（不填则用请求域名）
BASE_URL=
